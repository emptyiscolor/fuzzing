# Kernel config fragment for audit/debugging builds.
# Merge onto defconfig with: scripts/kconfig/merge_config.sh -m .config configs/audit.config

# Debug info + gdb scripts (needed for `gdb vmlinux` symbol/type info)
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_GDB_SCRIPTS=y
CONFIG_FRAME_POINTER=y

# Live kernel debugging over gdb stub (QEMU -s / kgdboc)
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y

# Bug-detection instrumentation for reproduction/verification
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_OUTLINE=y
CONFIG_UBSAN=y
CONFIG_UBSAN_SANITIZE_ALL=y
CONFIG_UBSAN_TRAP=n
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_LIST=y
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_SCHED_STACK_END_CHECK=y

# Panic/oops behavior useful for crash triage
CONFIG_PANIC_ON_OOPS=n
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
