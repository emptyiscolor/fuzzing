# Config fragment for hunting memory-safety bugs in net/.
# Merge AFTER audit.config:
#   scripts/kconfig/merge_config.sh -m .config ../configs/audit.config ../configs/net-audit.config
#
# Rationale: defconfig compiles almost none of net/ in, so most of the
# subsystem cannot be reached from a reproducer at all. Everything here is
# built =y (not =m) so a busybox initramfs can reach it with no module
# loading. KASAN is switched to INLINE because every memory access under
# TCG emulation is expensive and outline mode costs a call per access.

# --- Unprivileged reachability -------------------------------------------
# The single highest-leverage option: user namespaces let an unprivileged
# reproducer create a netns and reach protocol code that would otherwise
# need CAP_NET_ADMIN. This is how most syzbot net/ repros get their reach.
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y

# --- Protocols under audit ------------------------------------------------
# Chosen for weak fuzzer coverage and/or strong historical bug density.
CONFIG_IP_SCTP=y
CONFIG_TIPC=y
CONFIG_L2TP=y
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=y
CONFIG_L2TP_ETH=y
CONFIG_KCM=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_RDS=y
CONFIG_RDS_TCP=y
CONFIG_SMC=y
CONFIG_TLS=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_IPV6=y
CONFIG_IPV6_TUNNEL=y

# Ancient/low-traffic protocols: rarely exercised, still reachable.
CONFIG_HAMRADIO=y
CONFIG_AX25=y
CONFIG_NETROM=y
CONFIG_ROSE=y
CONFIG_IEEE802154=y
CONFIG_IEEE802154_SOCKET=y
CONFIG_NET_9P=y

# Bluetooth: L2CAP/HCI parsing + teardown races are a recurring UAF source.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y

# CAN: small, simple, and historically prone to OOB in frame handling.
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_J1939=y
CONFIG_CAN_VCAN=y

# --- netfilter / traffic control -----------------------------------------
# nf_tables set/chain lifetime and qdisc/classifier refcounting are two of
# the densest historical sources of UAF in the whole subsystem.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_FIB=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_OSF=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SYNPROXY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y

CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_HFSC=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_MULTIQ=y
CONFIG_NET_SCH_RED=y
CONFIG_NET_SCH_SFB=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_TEQL=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_CBS=y
CONFIG_NET_SCH_ETF=y
CONFIG_NET_SCH_TAPRIO=y
CONFIG_NET_SCH_GRED=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_DRR=y
CONFIG_NET_SCH_QFQ=y
CONFIG_NET_SCH_CODEL=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_HHF=y
CONFIG_NET_SCH_PIE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_PLUG=y
CONFIG_NET_SCH_ETS=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_ROUTE4=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FLOW=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_PEDIT=y
CONFIG_NET_ACT_CSUM=y
CONFIG_NET_ACT_CT=y

# --- Virtual devices reproducers need to attach qdiscs/filters to ---------
CONFIG_DUMMY=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_IFB=y
CONFIG_NLMON=y

# --- Instrumentation ------------------------------------------------------
# KASAN inline: faster under TCG than outline (no call per access).
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
# Report and keep going rather than halting on the first hit, so one boot
# can surface more than a single bug.
CONFIG_KASAN_MULTI_SHOT=y

# Fault injection: most refcount/free bugs live on error paths that never
# execute in normal operation. Being able to force allocation failure from
# userspace is how you actually reach them.
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FUNCTION_ERROR_INJECTION=y

# Reference-count and object-lifetime checking.
CONFIG_REFCOUNT_FULL=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RT_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_NET=y

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KGDB=y
CONFIG_MAGIC_SYSRQ=y

# Needed by reproducers that pin themselves / drive cgroups or bpf.
CONFIG_CGROUPS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
